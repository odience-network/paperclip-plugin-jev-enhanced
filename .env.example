# Copy to `.env` (gitignored) for `pnpm test:live`. Never commit real values,
# never paste them into issues or PRs, never add them as CI secrets.
VERDICT_LIVE_TYPESAFE_TOKEN=
# Optional: point the typesafe live run at a different SystemOne root.
VERDICT_LIVE_TYPESAFE_BASE_URL=
# Read by the Cloudflare and OpenAI live rows once G3 adds them.
VERDICT_LIVE_CLOUDFLARE_TOKEN=
VERDICT_LIVE_CLOUDFLARE_ACCOUNT_ID=
VERDICT_LIVE_OPENAI_TOKEN=
